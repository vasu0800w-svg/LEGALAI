   "start": true,
   "bold": true,
   "underline": true,
   "align": "center",
   "x": 581.0,
   "y": 601.3,
   "w": 78.0,
   "h": 35.9
  },
  {
   "page": 3,
   "kind": "verification",
   "text": "मैं रमेश कुमार पटेल सत्यापित करता हूँ कि उपरोक्त कथन मेरी जानकारी एवं",
   "start": true,
   "bold": false,
   "underline": false,
   "align": "left",
   "x": 124.9,
   "y": 668.4,
   "w": 667.2,
   "h": 35.9
  },
  {
   "page": 3,
   "kind": "verification",
   "text": "विश्वास में सत्य हैं। आज दिनांक 20/03/2025 को रायगढ़ में हस्ताक्षरित।",
   "start": false,
   "bold": false,
