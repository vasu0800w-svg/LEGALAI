rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each user may only read/write their own chat uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && !request.resource.name.matches('.*\\.\\..*')
        && (
          request.resource.contentType.matches('image/jpeg')
          || request.resource.contentType.matches('image/png')
          || request.resource.contentType.matches('image/webp')
          || request.resource.contentType.matches('image/gif')
          || request.resource.contentType.matches('image/heic')
          || request.resource.contentType.matches('image/heif')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/plain')
          || request.resource.contentType.matches('text/rtf')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }
  }
}
