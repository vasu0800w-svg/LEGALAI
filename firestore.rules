rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only this account may edit plans / prices / keys from the admin panel.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@casemate.com'];
    }

    // Fields only the backend (Admin SDK, which bypasses these rules) may change.
    // Same-value writes are not "affected keys", so existing app builds that
    // re-send their current plan on every sync keep working; only an actual
    // change (e.g. free -> pro without paying) is rejected.
    function entitlementsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'subscriptionExpiryDate', 'aiUsage', 'devices', 'planSource', 'planOrderId', 'promoKind', 'promoExpiresAt', 'promoRedeemedAt', 'promoCode', 'addOns', 'billingCycleStart', 'paymentStatus', 'grantedLimits', 'entitlementsVersion', 'billingHistory', 'customPlan']);
    }

    // Per-user chat / profile data (and per-chat docs under /chats/{chatId})
    match /users_data/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A new account may only start on the free plan.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['aiUsage', 'devices', 'planSource', 'planOrderId', 'promoKind', 'promoExpiresAt', 'promoRedeemedAt', 'promoCode', 'addOns', 'billingCycleStart', 'paymentStatus', 'grantedLimits', 'entitlementsVersion', 'billingHistory', 'customPlan']);

      allow update: if request.auth != null && request.auth.uid == userId
        && entitlementsUnchanged();

      allow delete: if false;

      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Admin panel → all phones (plans, announcement, templates)
    // Public read so every app install receives live price/announcement updates.
    match /app_config/{docId} {
      allow read: if docId in ['plans', 'announcement', 'templates'] || isAdmin();
      allow write: if isAdmin()
        && docId in ['plans', 'announcement', 'templates', 'api_keys', 'email_keys', 'promo_codes'];
    }

    // Payment records are written by the backend only.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Live presence so the admin panel can count who is using the app.
    // Each account may write only its own row. Plan here is display-only.
    function directoryFields(data) {
      return data.keys().hasAll(['name', 'email', 'plan', 'lastSeen'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 120
        && data.email is string
        && data.email.size() < 200
        && data.email == request.auth.token.email
        && data.plan is string
        && data.plan.size() < 40
        && data.lastSeen is number;
    }

    match /user_directory/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && directoryFields(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'email', 'plan', 'lastSeen', 'createdAt'])
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && directoryFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'plan', 'lastSeen']);
      allow delete: if false;
    }

    // Visit / login / signup counters. Clients may only add 1 to a single field.
    function statsShape(data) {
      return data.keys().hasOnly(['visits', 'logins', 'signups'])
        && data.visits is number && data.visits >= 0 && data.visits < 1000000000
        && data.logins is number && data.logins >= 0 && data.logins < 1000000000
        && data.signups is number && data.signups >= 0 && data.signups < 1000000000;
    }

    match /site_stats/summary {
      allow read: if isAdmin();

      allow create: if statsShape(request.resource.data)
        && (
          (request.resource.data.visits == 1
            && request.resource.data.logins == 0
            && request.resource.data.signups == 0)
          || (request.auth != null
            && request.resource.data.visits == 0
            && request.resource.data.logins == 1
            && request.resource.data.signups == 0)
          || (request.auth != null
            && request.resource.data.visits == 0
            && request.resource.data.logins == 0
            && request.resource.data.signups == 1)
        );

      allow update: if statsShape(request.resource.data)
        && request.resource.data.visits >= resource.data.visits
        && request.resource.data.logins >= resource.data.logins
        && request.resource.data.signups >= resource.data.signups
        && request.resource.data.visits + request.resource.data.logins + request.resource.data.signups
            == resource.data.visits + resource.data.logins + resource.data.signups + 1
        && (
          request.resource.data.visits == resource.data.visits + 1
          || request.auth != null
        );

      allow delete: if false;
    }

    // Email codes are written only by the server. Clients never read them.
    match /auth_otps/{id} {
      allow read, write: if false;
    }

    // Anonymized draft-style memory (structure only — no names/facts)
    match /learned_styles/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['skeleton', 'language', 'caseType', 'notes', 'createdAt', 'updatedAt'])
        && request.resource.data.skeleton is string
        && request.resource.data.skeleton.size() > 0
        && request.resource.data.skeleton.size() < 2500
        && request.resource.data.language is string
        && request.resource.data.language.size() < 40
        && request.resource.data.caseType is string
        && request.resource.data.caseType.size() < 80
        && request.resource.data.notes is string
        && request.resource.data.notes.size() < 500
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    match /auth_otp_limits/{id} {
      allow read, write: if false;
    }
  }
}
